/* =========================================================
   LOCAL AI — UI
   Clean dark developer workspace
   ========================================================= */

.local-ai {
  --bg: #08090d;
  --panel: #0d0f14;
  --panel-2: #11131a;
  --panel-3: #151821;

  --border: #20232c;
  --border-light: #2b2f3a;

  --text: #eceef4;
  --text-soft: #a8acb8;
  --text-muted: #686d79;

  --purple: #9b5cff;
  --purple-2: #7b3ff2;
  --purple-soft: rgba(155, 92, 255, 0.12);

  --green: #39d98a;
  --red: #ff5c70;
  --yellow: #e7b84b;

  width: 100vw;
  height: 100vh;
  overflow: hidden;

  display: flex;
  flex-direction: column;

  background: var(--bg);
  color: var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  font-size: 13px;
}

/* =========================================================
   RESET
   ========================================================= */

.local-ai *,
.local-ai *::before,
.local-ai *::after {
  box-sizing: border-box;
}

.local-ai button,
.local-ai select,
.local-ai textarea {
  font: inherit;
}

.local-ai button {
  border: 0;
  outline: none;
  color: inherit;
  background: transparent;
  cursor: pointer;
}

.local-ai button:disabled {
  cursor: default;
  opacity: 0.45;
}

/* =========================================================
   TOP BAR
   ========================================================= */

 .topbar {
  height: 58px;
  min-height: 58px;

  display: flex;
  align-items: center;

  padding: 0 15px;
  gap: 10px;

  border-bottom: 1px solid var(--border);
  background: #0b0c11;
}

.brand {
  width: 120px;

  display: flex;
  align-items: center;
  gap: 9px;

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.brand-mark {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 7px;

  color: white;
  background: linear-gradient(
    135deg,
    #b86cff,
    #7134e8
  );

  box-shadow:
    0 0 20px rgba(155, 92, 255, 0.25);
}

.project-select {
  height: 31px;

  display: flex;
  align-items: center;
  gap: 7px;

  max-width: 190px;

  padding: 0 10px;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: var(--panel-2);
  color: var(--text-soft);

  font-size: 11px;
}

.project-select:hover {
  border-color: var(--border-light);
  color: var(--text);
}

.modes {
  height: 100%;

  display: flex;
  align-items: center;

  margin-left: 5px;
  gap: 2px;
}

.mode {
  height: 32px;

  padding: 0 12px;

  border-radius: 6px;

  color: var(--text-muted);
  font-size: 11px;
}

.mode:hover {
  color: var(--text);
  background: var(--panel-2);
}

.mode.active {
  color: #fff;
  background: var(--purple-soft);
}

.top-right {
  margin-left: auto;

  display: flex;
  align-items: center;
  gap: 6px;
}

.model {
  height: 31px;
  max-width: 210px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 6px;

  outline: none;

  background: var(--panel-2);
  color: var(--text-soft);

  font-size: 11px;
}

.model:focus {
  border-color: rgba(155, 92, 255, 0.55);
}

.top-icon,
.user-icon {
  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  border-radius: 6px;

  color: var(--text-muted);
}

.top-icon:hover,
.user-icon:hover {
  background: var(--panel-2);
  color: var(--text);
}

.user-icon {
  color: white;
  background: #252834;
}

/* =========================================================
   WORKSPACE
   ========================================================= */

.workspace {
  min-height: 0;
  flex: 1;

  display: grid;

  grid-template-columns:
    240px
    minmax(0, 1fr)
    330px;

  overflow: hidden;
}

/* =========================================================
   LEFT SIDEBAR
   ========================================================= */

.left-sidebar {
  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow-y: auto;

  border-right: 1px solid var(--border);
  background: #0c0e13;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.new-project {
  height: 35px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  margin: 12px;

  border: 1px solid rgba(155, 92, 255, 0.4);
  border-radius: 7px;

  color: #dfd0ff;
  background: var(--purple-soft);

  font-size: 11px;
  font-weight: 600;

  transition: 0.15s ease;
}

.new-project:hover {
  border-color: rgba(155, 92, 255, 0.65);
  background: rgba(155, 92, 255, 0.19);
}

.sidebar-section {
  padding: 7px 10px 10px;
}

.section-title {
  margin-bottom: 7px;

  color: #686d79;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.sidebar-row {
  min-height: 29px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 8px;

  border-radius: 6px;

  color: var(--text-soft);

  font-size: 11px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  transition:
    background 0.12s ease,
    color 0.12s ease;
}

.sidebar-row svg {
  flex-shrink: 0;
}

.sidebar-row:hover {
  background: var(--panel-2);
  color: var(--text);
}

.sidebar-row.selected {
  color: #eadfff;
  background: var(--purple-soft);
}

.sidebar-row.muted {
  margin-top: 2px;
  color: var(--text-muted);
}

.tools {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3px;
}

.tool {
  height: 44px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 4px;

  border-radius: 6px;

  color: var(--text-muted);

  font-size: 8px;
}

.tool:hover {
  color: var(--text);
  background: var(--panel-2);
}

.system-status {
  margin-top: auto;

  padding: 12px;

  border-top: 1px solid var(--border);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 4px 0;

  color: var(--text-muted);
  font-size: 10px;
}

.status-row strong {
  color: var(--text-soft);
  font-weight: 600;
}

/* =========================================================
   CENTER
   ========================================================= */

.center {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;

  background: #0a0c10;
}

/* =========================================================
   TASK HEADER
   ========================================================= */

.task-header {
  min-height: 68px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 20px;

  border-bottom: 1px solid var(--border);
  background: #0c0e13;
}

.task-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.task-title h1 {
  margin: 0;

  color: var(--text);

  font-size: 15px;
  font-weight: 650;
}

.progress {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: var(--text-muted);

  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.progress i {
  width: 6px;
  height: 6px;

  display: block;

  border-radius: 50%;
  background: var(--green);

  box-shadow: 0 0 8px rgba(57, 217, 138, 0.6);
}

.task-subtitle {
  margin: 5px 0 0;

  color: var(--text-muted);

  font-size: 10px;
}

.task-buttons {
  display: flex;
  align-items: center;
  gap: 5px;
}

.task-buttons button {
  height: 29px;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 6px;

  color: var(--text-muted);
  background: var(--panel);

  font-size: 10px;
}

.task-buttons button:hover:not(:disabled) {
  color: var(--text);
  border-color: var(--border-light);
}

.task-buttons .stop {
  color: #ff8794;
  border-color: rgba(255, 92, 112, 0.22);
  background: rgba(255, 92, 112, 0.06);
}

/* =========================================================
   CHAT
   ========================================================= */

.chat {
  min-height: 0;
  flex: 1;

  overflow-y: auto;

  padding: 24px 30px 20px;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.empty-chat {
  min-height: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  color: var(--text-muted);

  text-align: center;
}

.empty-chat svg {
  margin-bottom: 12px;

  color: var(--purple);

  opacity: 0.8;
}

.empty-chat h2 {
  margin: 0 0 6px;

  color: var(--text-soft);

  font-size: 18px;
  font-weight: 600;
}

.empty-chat p {
  margin: 0 0 8px;

  font-size: 12px;
}

.empty-chat small {
  max-width: 500px;

  color: #555b67;

  font-size: 10px;
  word-break: break-all;
}

.message {
  max-width: 900px;

  display: flex;
  gap: 11px;

  margin: 0 auto 22px;
}

.message-avatar {
  width: 28px;
  height: 28px;

  flex: 0 0 28px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 7px;

  color: var(--text-muted);
  background: var(--panel-2);
}

.message.ai .message-avatar {
  color: #d7c0ff;

  border-color: rgba(155, 92, 255, 0.25);
  background: rgba(155, 92, 255, 0.08);
}

.message.user .message-avatar {
  color: #c5cad4;
}

.message-body {
  min-width: 0;
  flex: 1;
}

.message-name {
  margin-bottom: 5px;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 700;
}

.message-body p {
  margin: 0;

  color: #c6cad3;

  font-size: 12px;
  line-height: 1.7;

  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message.user .message-body p {
  color: #e0e3e9;
}

.thinking {
  color: var(--text-muted) !important;
  font-style: italic;
}

.ai-error {
  max-width: 900px;

  display: flex;
  gap: 8px;

  margin: 0 auto 18px;
  padding: 10px 12px;

  border: 1px solid rgba(255, 92, 112, 0.22);
  border-radius: 7px;

  color: #ff9aa5;
  background: rgba(255, 92, 112, 0.06);

  font-size: 11px;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer {
  min-height: 62px;

  display: flex;
  align-items: flex-end;
  gap: 7px;

  padding: 10px 18px 14px;

  border-top: 1px solid var(--border);
  background: #0c0e13;
}

.composer textarea {
  min-height: 39px;
  max-height: 150px;

  flex: 1;

  resize: none;

  padding: 11px 12px;

  border: 1px solid var(--border);
  border-radius: 7px;

  outline: none;

  color: var(--text);
  background: #101218;

  font-size: 12px;
  line-height: 1.45;

  scrollbar-width: thin;
}

.composer textarea::placeholder {
  color: #555b67;
}

.composer textarea:focus {
  border-color: rgba(155, 92, 255, 0.48);

  box-shadow:
    0 0 0 2px rgba(155, 92, 255, 0.06);
}

.composer > button {
  width: 39px;
  height: 39px;

  display: grid;
  place-items: center;

  flex: 0 0 39px;

  border: 1px solid var(--border);
  border-radius: 7px;

  color: var(--text-muted);
  background: var(--panel-2);
}

.composer > button:hover:not(:disabled) {
  color: var(--text);
  border-color: var(--border-light);
}

.composer > .send {
  color: white;
  border-color: rgba(155, 92, 255, 0.5);

  background: linear-gradient(
    135deg,
    #9b5cff,
    #7438df
  );

  box-shadow:
    0 0 15px rgba(155, 92, 255, 0.14);
}

/* =========================================================
   RIGHT SIDEBAR
   ========================================================= */

.right-sidebar {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;

  overflow-y: auto;

  border-left: 1px solid var(--border);
  background: #0c0e13;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.right-tabs {
  height: 42px;
  min-height: 42px;

  display: flex;
  align-items: center;

  padding: 0 10px;

  gap: 4px;

  border-bottom: 1px solid var(--border);
}

.right-tabs button {
  height: 27px;

  padding: 0 8px;

  border-radius: 5px;

  color: var(--text-muted);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.right-tabs button:hover {
  color: var(--text);
}

.right-tabs button.active {
  color: #ddd0ff;
  background: var(--purple-soft);
}

.file-tree {
  padding-bottom: 12px;

  border-bottom: 1px solid var(--border);
}

.path {
  min-height: 38px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 0 12px;

  color: var(--text-muted);

  font-size: 10px;

  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.path svg {
  flex-shrink: 0;
  color: #9a9fac;
}

.tree-row {
  min-height: 25px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding-right: 8px;

  color: #969ba7;

  font-size: 10px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-row:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.025);
}

.tree-row svg {
  flex-shrink: 0;
}

.tree-row .folder {
  color: #c0a1ff;
}

.tree-indent {
  width: 11px;
  flex: 0 0 11px;
}

.info-card {
  padding: 14px 12px;

  border-bottom: 1px solid var(--border);
}

.info-row {
  min-height: 25px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;

  color: var(--text-muted);

  font-size: 10px;
}

.info-row strong {
  max-width: 160px;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 500;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  padding: 14px 12px;
}

.timeline-row {
  min-height: 27px;

  display: grid;
  grid-template-columns: 32px 10px minmax(0, 1fr);
  align-items: center;
  gap: 5px;

  color: var(--text-muted);

  font-size: 9px;
}

.timeline-row strong {
  color: var(--purple);
  font-size: 7px;
}

.timeline-row p {
  margin: 0;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   BOTTOM PANEL
   ========================================================= */

.bottom {
  height: 150px;
  min-height: 150px;

  border-top: 1px solid var(--border);

  background: #0b0d12;
}

.bottom-tabs {
  height: 36px;

  display: flex;
  align-items: center;

  padding: 0 14px;

  gap: 4px;

  border-bottom: 1px solid var(--border);
}

.bottom-tabs button {
  height: 28px;

  padding: 0 9px;

  border-radius: 5px;

  color: var(--text-muted);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.bottom-tabs button:hover {
  color: var(--text);
}

.bottom-tabs button.active {
  color: #d9c8ff;
  background: var(--purple-soft);
}

.bottom-content {
  height: calc(100% - 36px);

  display: grid;

  grid-template-columns:
    1fr
    1.4fr
    0.7fr
    1fr;

  gap: 20px;

  padding: 13px 18px;
}

.bottom-content > div {
  min-width: 0;
}

.bottom-content p {
  margin: 3px 0;

  color: var(--text-soft);

  font-size: 10px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-content small {
  color: var(--text-muted);
  font-size: 9px;
}

.bottom-content code {
  color: #73e0a8;
  font-size: 10px;
}

.expected {
  padding-left: 16px;

  border-left: 1px solid var(--border);
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

.local-ai ::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.local-ai ::-webkit-scrollbar-track {
  background: transparent;
}

.local-ai ::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #292d37;
}

.local-ai ::-webkit-scrollbar-thumb:hover {
  background: #363b48;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {
  .workspace {
    grid-template-columns:
      190px
      minmax(0, 1fr)
      245px;
  }

  .bottom-content {
    grid-template-columns:
      1fr
      1fr
      0.7fr;
  }

  .expected {
    display: none;
  }
}

@media (max-width: 820px) {
  .workspace {
    grid-template-columns:
      175px
      minmax(0, 1fr);
  }

  .right-sidebar {
    display: none;
  }

  .mode:nth-child(n + 3) {
    display: none;
  }
}

