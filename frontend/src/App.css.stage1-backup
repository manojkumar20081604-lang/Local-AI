   ========================================================= */

.left-sidebar {
  background:
    linear-gradient(
      180deg,
      #0b0d13 0%,
      #090b10 100%
    );

  border-right-color: #20232d;
}

.new-project {
  height: 36px;

  margin: 13px 12px;

  border-color: rgba(155, 92, 255, 0.38);

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.15),
      rgba(116, 55, 232, 0.08)
    );

  box-shadow:
    0 4px 18px rgba(0, 0, 0, 0.12);
}

.new-project:hover {
  transform: translateY(-1px);

  border-color: rgba(155, 92, 255, 0.65);

  box-shadow:
    0 5px 22px rgba(96, 44, 190, 0.15);
}

.sidebar-section {
  padding: 8px 10px 11px;
}

.section-title {
  color: #5f6471;

  font-size: 8px;
  letter-spacing: 0.13em;
}

.sidebar-row {
  min-height: 30px;

  padding: 0 9px;

  border: 1px solid transparent;
  border-radius: 6px;

  color: #858a97;

  transition:
    background 0.12s ease,
    border-color 0.12s ease,
    color 0.12s ease;
}

.sidebar-row:hover {
  background: #11141c;
  border-color: #1e222c;
}

.sidebar-row.selected {
  color: #e5d8ff;

  border-color: rgba(155, 92, 255, 0.16);

  background:
    linear-gradient(
      90deg,
      rgba(155, 92, 255, 0.14),
      rgba(155, 92, 255, 0.04)
    );

  box-shadow:
    inset 2px 0 0 var(--purple);
}

.sidebar-row.muted {
  color: #5f6470;
}

.tools {
  gap: 4px;
}

.tool {
  height: 47px;

  border: 1px solid transparent;
  border-radius: 7px;

  color: #686e7b;

  transition:
    background 0.12s ease,
    border-color 0.12s ease;
}

.tool:hover {
  background: #11141c;
  border-color: #20242f;
}

.system-status {
  padding: 13px;

  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(255,255,255,0.008)
    );
}

.status-row {
  min-height: 24px;
}

.status-row strong {
  color: #8d93a0;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

/* =========================================================
   CENTER WORKSPACE
   ========================================================= */

.center {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(155, 92, 255, 0.025),
      transparent 35%
    ),
    #090b10;
}

.task-header {
  min-height: 72px;

  padding: 0 22px;

  background:
    linear-gradient(
      180deg,
      #0d0f15,
      #0b0d12
    );

  border-bottom-color: #20232d;
}

.task-title h1 {
  font-size: 15px;
  letter-spacing: -0.015em;
}

.task-subtitle {
  color: #646a77;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.progress {
  padding: 3px 7px;

  border: 1px solid rgba(57, 217, 138, 0.12);
  border-radius: 10px;

  background: rgba(57, 217, 138, 0.035);

  font-size: 8px;
}

.chat {
  padding:
    28px
    clamp(24px, 5vw, 70px)
    22px;

  background:
    radial-gradient(
      ellipse at 50% 15%,
      rgba(92, 51, 164, 0.035),
      transparent 45%
    );
}

.empty-chat svg {
  width: 38px;
  height: 38px;

  padding: 8px;

  border: 1px solid rgba(155, 92, 255, 0.22);
  border-radius: 10px;

  background: rgba(155, 92, 255, 0.07);

  filter:
    drop-shadow(
      0 0 14px rgba(155, 92, 255, 0.22)
    );
}

.empty-chat h2 {
  margin-top: 2px;

  font-size: 19px;
  letter-spacing: -0.02em;
}

.empty-chat p {
  color: #777c89;
}

.message {
  max-width: 980px;

  margin-bottom: 25px;
}

.message-avatar {
  width: 30px;
  height: 30px;

  flex-basis: 30px;

  border-radius: 8px;

  background: #10131a;
}

.message.ai .message-avatar {
  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.15),
      rgba(116, 55, 232, 0.05)
    );

  border-color: rgba(155, 92, 255, 0.25);
}

.message-name {
  color: #8d92a0;

  font-size: 9px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.message.ai .message-name {
  color: #b99bff;
}

.message-body p {
  color: #c7cbd4;

  font-size: 12px;
  line-height: 1.75;
}

.ai-error {
  border-radius: 8px;

  background:
    linear-gradient(
      90deg,
      rgba(255, 92, 112, 0.08),
      rgba(255, 92, 112, 0.035)
    );

  box-shadow:
    0 4px 20px rgba(0,0,0,0.12);
}

/* =========================================================
   EDIT PROPOSAL
   ========================================================= */

.edit-proposal {
  margin:
    0
    clamp(18px, 5vw, 70px)
    12px;

  overflow: hidden;

  border: 1px solid rgba(155, 92, 255, 0.22);
  border-radius: 9px;

  background: #0c0f15;

  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.2),
    0 0 20px rgba(155, 92, 255, 0.035);
}

.edit-proposal-header {
  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 8px 11px;

  border-bottom: 1px solid #20232d;

  background:
    linear-gradient(
      90deg,
      rgba(155, 92, 255, 0.08),
      transparent
    );
}

.edit-proposal-header > div:first-child {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 3px;
}

.edit-proposal-header strong {
  color: #ddd2f4;

  font-size: 10px;
}

.edit-proposal-header span {
  color: #777d8b;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-proposal-actions {
  display: flex;
  gap: 5px;
}

.edit-proposal-actions button {
  height: 27px;

  padding: 0 9px;

  border: 1px solid #2a2e39;
  border-radius: 5px;

  color: #8b909c;

  background: #11141b;

  font-size: 9px;
  font-weight: 650;
}

.edit-proposal-actions button:hover {
  color: #e5e7ed;
  border-color: #3b4050;
}

.edit-proposal-actions .apply-edit {
  color: #eadfff;

  border-color: rgba(155, 92, 255, 0.38);

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.18),
      rgba(116, 55, 232, 0.10)
    );
}

.edit-proposal pre {
  max-height: 220px;

  margin: 0;

  padding: 13px;

  overflow: auto;

  color: #abb0bc;

  background: #090b10;

  font-family:
    "JetBrains Mono",
    "Fira Code",
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 10px;
  line-height: 1.65;

  white-space: pre-wrap;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer {
  min-height: 70px;

  padding:
    10px
    clamp(18px, 4vw, 58px)
    15px;

  background:
    linear-gradient(
      180deg,
      #0b0d12,
      #0d0f15
    );

  border-top-color: #20232d;
}

.composer textarea {
  min-height: 42px;

  background: #10131a;

  border-color: #272b36;

  box-shadow:
    inset 0 1px 3px rgba(0,0,0,0.18);
}

.composer textarea:focus {
  border-color: rgba(155, 92, 255, 0.55);

  box-shadow:
    0 0 0 2px rgba(155, 92, 255, 0.055),
    0 0 18px rgba(155, 92, 255, 0.035);
}

.composer > button {
  width: 42px;
  height: 42px;

  flex-basis: 42px;

  border-radius: 8px;
}

.composer > .send {
  border-color: rgba(155, 92, 255, 0.55);

  background:
    linear-gradient(
      135deg,
      #a361ff,
      #7437e8
    );

  box-shadow:
    0 0 18px rgba(155, 92, 255, 0.17);
}

/* =========================================================
   RIGHT SIDEBAR
   ========================================================= */

.right-sidebar {
  background:
    linear-gradient(
      180deg,
      #0b0d13,
      #090b10
    );

  border-left-color: #20232d;
}

.right-tabs {
  height: 44px;
  min-height: 44px;

  padding: 0 11px;
}

.right-tabs button {
  font-size: 8px;
  letter-spacing: 0.08em;
}

.right-tabs button.active {
  color: #ded1fa;

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.13),
      rgba(155, 92, 255, 0.05)
    );
}

.file-tree {
  background: rgba(255,255,255,0.003);
}

.path {
  min-height: 40px;

  padding: 0 13px;

  border-bottom: 1px solid rgba(255,255,255,0.015);

  color: #727784;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.path svg {
  color: #a078ed;
}

.tree-row {
  min-height: 27px;

  padding-right: 10px;

  color: #888e9b;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.tree-row:hover {
  background: rgba(155, 92, 255, 0.045);
}

.tree-row .folder {
  color: #a77cff;
}

.info-card {
  padding: 13px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0.008),
      transparent
    );
}

.info-row {
  min-height: 27px;
}

.info-row strong {
  color: #a8adb9;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.timeline {
  padding: 14px 13px;
}

.timeline-row {
  min-height: 29px;

  grid-template-columns: 30px 10px minmax(0,1fr);

  font-size: 8px;
}

.timeline-row strong {
  color: #9b5cff;

  text-shadow:
    0 0 8px rgba(155, 92, 255, 0.6);
}

/* =========================================================
   BOTTOM WORKSPACE
   ========================================================= */

.bottom {
  height: 158px;
  min-height: 158px;

  background:
    linear-gradient(
      180deg,
      #0b0d12,
      #090b10
    );

  box-shadow:
    0 -8px 25px rgba(0,0,0,0.08);
}

.bottom-tabs {
  height: 38px;

  padding: 0 15px;
}

.bottom-tabs button {
  position: relative;

  font-size: 8px;
  letter-spacing: 0.08em;
}

.bottom-tabs button.active {
  color: #ded1fa;

  background: rgba(155, 92, 255, 0.10);
}

.bottom-tabs button.active::after {
  content: "";

  position: absolute;

  left: 8px;
  right: 8px;
  bottom: 0;

  height: 1px;

  background: var(--purple);
}

.bottom-content {
  height: calc(100% - 38px);

  grid-template-columns:
    0.9fr
    1.7fr
    0.8fr
    1.1fr;

  gap: 24px;

  padding: 14px 19px;
}

.bottom-content p {
  color: #b0b4bf;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.bottom-content small {
  color: #626875;

  font-size: 8px;
}

.bottom-content code {
  color: #61dca1;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.expected {
  border-left-color: #222631;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .workspace {
    grid-template-columns:
      210px
      minmax(0, 1fr)
      260px;
  }

  .brand {
    width: 125px;
  }

  .brand::after {
    display: none;
  }

  .project-select {
    max-width: 160px;
  }

  .mode {
    padding: 0 9px;
  }
}

@media (max-width: 950px) {
  .workspace {
    grid-template-columns:
      190px
      minmax(0, 1fr)
      235px;
  }

  .bottom-content {
    grid-template-columns:
      1fr
      1fr
      0.7fr;
  }

  .expected {
    display: none;
  }
}

@media (max-width: 780px) {
  .workspace {
    grid-template-columns:
      175px
      minmax(0, 1fr);
  }

  .right-sidebar {
    display: none;
  }

  .mode:nth-child(n + 3) {
    display: none;
  }
}


