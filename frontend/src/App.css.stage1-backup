    0 0 18px rgba(143,81,245,0.18);
}

.composer > .send:hover:not(:disabled) {
  background: #9d60ff;
}

/* ---------- Error ---------- */

.ai-error {
  max-width: 940px;
  border-radius: 8px;
}

/* ---------- Empty state ---------- */

.empty-chat {
  opacity: 0.85;
}

.empty-chat svg {
  width: 34px;
  height: 34px;

  padding: 7px;

  border: 1px solid rgba(155,92,255,0.22);
  border-radius: 9px;

  background: rgba(155,92,255,0.08);
}

.empty-chat h2 {
  font-size: 17px;
}

.empty-chat p {
  color: #777d89;
}


/* =========================================================
   STAGE 2 — CENTER WORKSPACE UPGRADE
   ========================================================= */

.center {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #090b10;
}

/* Task header */

.task-header {
  min-height: 72px;
  padding: 0 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #20232c;
  background: #0c0e14;
}

.task-title h1 {
  font-size: 16px;
  font-weight: 650;
  letter-spacing: -0.01em;
}

.task-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.progress {
  height: 21px;
  padding: 0 8px;
  border: 1px solid rgba(155,92,255,.25);
  border-radius: 5px;
  color: #cdb8ff;
  background: rgba(155,92,255,.08);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: .04em;
}

.progress i {
  width: 5px;
  height: 5px;
  background: #9b5cff;
  box-shadow: 0 0 8px rgba(155,92,255,.8);
}

.task-subtitle {
  margin-top: 5px;
  color: #666c79;
  font-size: 10px;
}

.task-buttons {
  gap: 6px;
}

.task-buttons button {
  height: 30px;
  padding: 0 10px;
  border: 1px solid #242833;
  border-radius: 6px;
  background: #11141b;
}

.task-buttons button:hover:not(:disabled) {
  border-color: #393e4b;
  background: #151821;
}

.task-buttons .stop {
  color: #ff8794;
}

/* Chat */

.chat {
  min-height: 0;
  flex: 1;
  overflow-y: auto;
  padding: 28px 34px 22px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(86,56,150,.055),
      transparent 45%
    ),
    #090b10;
}

.message {
  max-width: 920px;
  margin: 0 auto 24px;
}

.message-avatar {
  width: 30px;
  height: 30px;
  flex-basis: 30px;
  border-radius: 8px;
  background: #11141b;
}

.message.ai .message-avatar {
  color: #d8c4ff;
  background: rgba(155,92,255,.1);
  border-color: rgba(155,92,255,.3);
}

.message-name {
  color: #aeb3bf;
  font-size: 10px;
  font-weight: 700;
}

.message-body p {
  max-width: 760px;
  color: #cdd1da;
  font-size: 12px;
  line-height: 1.75;
}

/* AI thinking */

.thinking {
  color: #777d89 !important;
}

/* Edit proposal */

.edit-proposal {
  max-width: 920px;
  margin: 0 auto 18px;
  overflow: hidden;
  border: 1px solid rgba(155,92,255,.25);
  border-radius: 9px;
  background: #0d1017;
  box-shadow: 0 8px 30px rgba(0,0,0,.18);
}

.edit-proposal-header {
  min-height: 52px;
  padding: 10px 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  border-bottom: 1px solid #20232c;
  background: #11141b;
}

.edit-proposal-header > div:first-child {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.edit-proposal-header strong {
  color: #ddd3f2;
  font-size: 11px;
}

.edit-proposal-header span {
  color: #747a87;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
}

.edit-proposal-actions {
  display: flex;
  gap: 6px;
}

.edit-proposal-actions button {
  height: 28px;
  padding: 0 10px;
  border: 1px solid #292e39;
  border-radius: 6px;
  color: #9ca2ae;
  background: #151821;
  font-size: 10px;
}

.edit-proposal-actions button:hover {
  color: #fff;
  border-color: #414754;
}

.edit-proposal-actions .apply-edit {
  color: #fff;
  border-color: rgba(155,92,255,.5);
  background: #7740dc;
}

.edit-proposal pre {
  max-height: 260px;
  margin: 0;
  padding: 14px;
  overflow: auto;
  color: #aeb5c1;
  background: #090b10;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 10px;
  line-height: 1.65;
}

/* Composer */

.composer {
  min-height: 72px;
  padding: 12px 20px 15px;
  gap: 7px;
  border-top: 1px solid #20232c;
  background: #0c0e14;
}

.composer textarea {
  min-height: 42px;
  padding: 12px 13px;
  border-color: #272b35;
  border-radius: 8px;
  background: #10131a;
  color: #e7e9ee;
  font-size: 11px;
}

.composer textarea:focus {
  border-color: rgba(155,92,255,.55);
  box-shadow: 0 0 0 2px rgba(155,92,255,.07);
}

.composer > button {
  width: 42px;
  height: 42px;
  flex-basis: 42px;
  border-radius: 8px;
  background: #11141b;
}

.composer > .send {
  background: #8248e8;
  border-color: rgba(155,92,255,.65);
  box-shadow: 0 0 18px rgba(155,92,255,.16);
}

.composer > .send:hover:not(:disabled) {
  background: #9158f2;
}

/* Empty state */

.empty-chat h2 {
  color: #c8cbd4;
  font-size: 17px;
}

.empty-chat p {
  color: #777d89;
}

.empty-chat svg {
  color: #9b5cff;
  filter: drop-shadow(0 0 10px rgba(155,92,255,.25));
}


/* =========================================================
   STAGE 3 — RIGHT IDE PANEL
   ========================================================= */

.right-sidebar {
  min-width: 0;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  border-left: 1px solid #20232c;
  background: #0b0d12;
  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

/* Tabs */

.right-tabs {
  height: 43px;
  min-height: 43px;
  padding: 0 11px;
  display: flex;
  align-items: center;
  gap: 3px;
  border-bottom: 1px solid #20232c;
  background: #0d0f15;
}

.right-tabs button {
  height: 28px;
  padding: 0 9px;
  border-radius: 5px;
  color: #686e7b;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .06em;
}

.right-tabs button:hover {
  color: #cfd2da;
  background: #12151c;
}

.right-tabs button.active {
  color: #dfd2ff;
  background: rgba(155,92,255,.12);
}

/* Project path */

.file-tree {
  padding-bottom: 9px;
  border-bottom: 1px solid #20232c;
}

.path {
  min-height: 39px;
  padding: 0 12px;
  display: flex;
  align-items: center;
  gap: 7px;
  color: #858b98;
  background: #0d0f15;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 9px;
}

.path svg {
  color: #a77cff;
}

/* File tree */

.tree-row {
  min-height: 26px;
  padding-right: 10px;
  display: flex;
  align-items: center;
  gap: 5px;
  color: #969ca8;
  border-radius: 3px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 10px;
}

.tree-row:hover {
  color: #e4e6eb;
  background: rgba(255,255,255,.025);
}

.tree-row svg {
  color: #707784;
}

.tree-row .folder {
  color: #ad8aff;
}

.tree-row.selected {
  color: #e7ddff;
  background: rgba(155,92,255,.1);
}

.tree-indent {
  width: 11px;
  min-width: 11px;
}

/* File metadata */

.tree-row::after {
  margin-left: auto;
  color: transparent;
  font-size: 9px;
}

.tree-row:hover::after {
  color: #555c68;
}

/* Overview */

.info-card {
  padding: 13px 12px;
  border-bottom: 1px solid #20232c;
  background: #0c0e13;
}

.info-card .section-title {
  margin-bottom: 9px;
}

.info-row {
  min-height: 25px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  color: #707682;
  font-size: 10px;
}

.info-row strong,
.info-row span:last-child {
  max-width: 160px;
  overflow: hidden;
  text-align: right;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #b7bbc5;
  font-weight: 600;
}

/* Project overview visual cards */

.info-card + .info-card {
  background: #0b0d12;
}

.project-meta-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5px;
}

.project-meta-card {
  min-height: 48px;
  padding: 8px;
  border: 1px solid #20232c;
  border-radius: 6px;
  background: #10131a;
}

.project-meta-card .label {
  color: #666c78;
  font-size: 8px;
  text-transform: uppercase;
  letter-spacing: .05em;
}

.project-meta-card .value {
  margin-top: 5px;
  color: #cdd1da;
  font-size: 10px;
  font-weight: 650;
}

/* Timeline */

.timeline {
  padding: 14px 12px 18px;
}

.timeline .section-title {
  margin-bottom: 12px;
}

.timeline-item {
  position: relative;
  display: grid;
  grid-template-columns: 48px 1fr;
  gap: 8px;
  min-height: 43px;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 53px;
  top: 18px;
  bottom: -4px;
  width: 1px;
  background: #252934;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-time {
  color: #555b67;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 8px;
}

.timeline-text {
  position: relative;
  padding-left: 11px;
  color: #858b97;
  font-size: 9px;
  line-height: 1.5;
}

.timeline-text::before {
  content: "";
  position: absolute;
  left: -1px;
  top: 3px;
  width: 5px;
  height: 5px;
  border: 1px solid #8050d7;
  border-radius: 50%;
  background: #0b0d12;
  box-shadow: 0 0 7px rgba(155,92,255,.3);
}

/* Compact scrollbar */

.right-sidebar::-webkit-scrollbar,
.chat::-webkit-scrollbar {
  width: 5px;
}

.right-sidebar::-webkit-scrollbar-thumb,
.chat::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #292d37;
}

.right-sidebar::-webkit-scrollbar-track,
.chat::-webkit-scrollbar-track {
  background: transparent;
}


/* =========================================================
   STAGE 4 — BOTTOM DEVELOPER WORKSPACE
   ========================================================= */

.bottom {
  height: 190px;
  min-height: 190px;
  display: flex;
  flex-direction: column;
  border-top: 1px solid #252832;
  background: #0a0c11;
  box-shadow: 0 -12px 30px rgba(0,0,0,.12);
}

/* Bottom navigation */

.bottom-tabs {
  height: 38px;
  min-height: 38px;
  display: flex;
  align-items: center;
  gap: 2px;
  padding: 0 14px;
  border-bottom: 1px solid #20232c;
  background: #0d0f14;
}

.bottom-tabs button {
  position: relative;
  height: 38px;
  padding: 0 11px;
  color: #686e7a;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .05em;
}

.bottom-tabs button:hover {
  color: #c7cad2;
}

.bottom-tabs button.active {
  color: #dcd0ff;
}

.bottom-tabs button.active::after {
  content: "";
  position: absolute;
  left: 9px;
  right: 9px;
  bottom: -1px;
  height: 2px;
  border-radius: 2px 2px 0 0;
  background: #9b5cff;
  box-shadow: 0 0 8px rgba(155,92,255,.45);
}

/* Bottom content */

.bottom-content {
  min-height: 0;
  flex: 1;
  display: grid;
  grid-template-columns: 1.1fr 1.1fr .8fr 1.4fr;
  gap: 0;
  overflow: hidden;
}

.bottom-content > div {
  min-width: 0;
  padding: 12px 15px;
  border-right: 1px solid #1d2028;
}

.bottom-content > div:last-child {
  border-right: 0;
}

.bottom-content .section-title {
  margin-bottom: 7px;
  color: #626875;
  font-size: 8px;
}

.bottom-content p {
  margin: 0;
  overflow: hidden;
  color: #c1c5ce;
  font-size: 10px;
  line-height: 1.5;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-content small {
  display: block;
  margin-top: 4px;
  color: #565c68;
  font-size: 9px;
}

.bottom-content code {
  display: inline-flex;
  align-items: center;
  min-height: 22px;
  padding: 0 7px;
  border: 1px solid rgba(57,217,138,.15);
  border-radius: 4px;
  color: #67dfa3;
  background: rgba(57,217,138,.06);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 9px;
}

/* Next action */

.bottom-content .expected {
  position: relative;
}

.bottom-content .expected p {
  max-width: 300px;
  color: #777d89;
  white-space: normal;
}

/* Bottom status indicator */

.bottom-content > div:nth-child(3)::after {
  content: "";
  display: block;
  width: 6px;
  height: 6px;
  margin-top: 9px;
  border-radius: 50%;
  background: #39d98a;
  box-shadow: 0 0 8px rgba(57,217,138,.45);
}

/* Simulation-style emphasis */

.bottom.simulation-active {
  border-top-color: rgba(155,92,255,.35);
}

.bottom.simulation-active .bottom-content {
  background:
    linear-gradient(
      90deg,
      rgba(155,92,255,.025),
      transparent 45%
    );
}

/* Compact project folder */

.bottom-content > div:nth-child(2) p {
  color: #8f96a3;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 9px;
}

/* Responsive */

@media (max-width: 1100px) {
  .bottom {
    height: 165px;
    min-height: 165px;
  }

  .bottom-content {
    grid-template-columns: 1fr 1fr .8fr;
  }

  .bottom-content .expected {
    display: none;
  }
}


/* =========================================================
   STAGE 5 — AI CODING AGENT CARDS
   ========================================================= */

.analysis-card {
  max-width: 900px;
  margin: 4px auto 24px;
  overflow: hidden;
  border: 1px solid #252934;
  border-radius: 9px;
  background: #0d1016;
  box-shadow: 0 8px 28px rgba(0,0,0,.16);
}

.analysis-header {
  min-height: 43px;
  display: flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  border-bottom: 1px solid #20232c;
  background: #11141b;
}

.analysis-header svg {
  color: #9b5cff;
}

.analysis-header strong {
  color: #cdd0d9;
  font-size: 10px;
  font-weight: 700;
}

.analysis-body {
  padding: 9px 13px 11px;
}

.analysis-row {
  min-height: 27px;
  display: grid;
  grid-template-columns: 17px 1fr auto;
  align-items: center;
  gap: 7px;
  color: #8e94a0;
  font-size: 9px;
}

.analysis-row svg {
  color: #39d98a;
}

.analysis-row .file {
  color: #b9bec8;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.analysis-row .status {
  color: #5e6572;
  font-size: 8px;
}

.analysis-row.active {
  color: #cfd3dc;
}

.analysis-row.active .status {
  color: #b995ff;
}

.analysis-progress {
  height: 2px;
  margin-top: 8px;
  overflow: hidden;
  border-radius: 2px;
  background: #1b1e26;
}

.analysis-progress::after {
  content: "";
  display: block;
  width: 68%;
  height: 100%;
  border-radius: inherit;
  background: #9b5cff;
  box-shadow: 0 0 8px rgba(155,92,255,.45);
}

/* Proposed changes */

.change-card {
  max-width: 900px;
  margin: 0 auto 22px;
  overflow: hidden;
  border: 1px solid rgba(155,92,255,.24);
  border-radius: 9px;
  background: #0d1016;
}

.change-header {
  min-height: 46px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #20232c;
  background: #11141b;
}

.change-header strong {
  color: #d6d9e1;
  font-size: 10px;
}

.change-header span {
  margin-left: 7px;
  color: #6d7380;
  font-size: 9px;
}

.change-files {
  padding: 4px 0;
}

.change-file {
  min-height: 34px;
  padding: 0 13px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #a6abb6;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 9px;
}

.change-file:hover {
  background: rgba(255,255,255,.025);
}

.change-count {
  color: #8f70c7;
  font-family: inherit;
  font-size: 8px;
}

.change-actions {
  display: flex;
  justify-content: flex-end;
  gap: 6px;
  padding: 9px 13px;
  border-top: 1px solid #20232c;
  background: #0b0d12;
}

.change-actions button {
  height: 27px;
  padding: 0 10px;
  border: 1px solid #292e38;
  border-radius: 5px;
  color: #9298a4;
  background: #11141a;
  font-size: 9px;
}

.change-actions button:hover {
  color: #fff;
  border-color: #424854;
}

.change-actions .primary {
  color: #fff;
  border-color: rgba(155,92,255,.5);
  background: #7740dc;
}

/* Diff preview */

.diff-preview {
  margin: 0;
  padding: 11px 13px;
  overflow-x: auto;
  border-top: 1px solid #20232c;
  color: #9299a6;
  background: #090b10;
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  font-size: 9px;
  line-height: 1.7;
}

.diff-remove {
  display: block;
  color: #ff8a99;
  background: rgba(255,92,112,.08);
}

.diff-add {
  display: block;
  color: #62dfa1;
  background: rgba(57,217,138,.08);
}

/* Agent activity */

.agent-event {
  max-width: 900px;
  margin: 0 auto 13px;
  padding-left: 41px;
  color: #686f7b;
  font-size: 9px;
}

.agent-event strong {
  color: #9c7bd1;
  font-weight: 600;
}

/* User message */

.message.user .message-avatar {
  border-color: #292e38;
  background: #12151c;
}

.message.user .message-body p {
  color: #d9dce3;
}

/* AI response emphasis */

.message.ai .message-body p {
  color: #c8ccd5;
}

.message.ai + .analysis-card {
  margin-top: -8px;
}

/* Small status badges */

.agent-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  min-height: 20px;
  padding: 0 7px;
  border: 1px solid rgba(155,92,255,.25);
  border-radius: 5px;
  color: #cbb7ee;
  background: rgba(155,92,255,.08);
  font-size: 8px;
  font-weight: 700;
}

.agent-badge.success {
  color: #69dfa4;
  border-color: rgba(57,217,138,.2);
  background: rgba(57,217,138,.06);
}

.agent-badge.warning {
  color: #e6bd69;
  border-color: rgba(231,184,75,.2);
  background: rgba(231,184,75,.06);
}


/* =========================================================
   AI AGENT RESPONSE UI
   ========================================================= */

.agent-message-content {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #cfd3dc;
}

.agent-message-content p {
  margin: 0;
  color: #c8ccd5;
  font-size: 12px;
  line-height: 1.7;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.agent-spacer {
  height: 2px;
}

.agent-section {
  margin-top: 4px;
  padding: 7px 10px;

  border-left: 2px solid var(--purple);

  color: #dfd5ff;
  background: rgba(155, 92, 255, 0.055);

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.agent-code-line {
  padding: 7px 10px;

  border: 1px solid var(--border);
  border-radius: 6px;

  color: #bfc5d1;
  background: #0b0d12;

  font-family:
    "JetBrains Mono",
    "Fira Code",
    "Cascadia Code",
    monospace;

  font-size: 10px;
  line-height: 1.55;

  white-space: pre-wrap;
  overflow-x: auto;
}

.agent-operation {
  margin: 5px 0;

  padding: 10px 12px;

  border: 1px solid rgba(155, 92, 255, 0.3);
  border-radius: 8px;

  color: #e5d9ff;
  background:
    linear-gradient(
      90deg,
      rgba(155, 92, 255, 0.10),
