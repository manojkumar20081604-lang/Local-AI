/* =========================================================
   LOCAL AI — UI
   Clean dark developer workspace
   ========================================================= */

.local-ai {
  --bg: #08090d;
  --panel: #0d0f14;
  --panel-2: #11131a;
  --panel-3: #151821;

  --border: #20232c;
  --border-light: #2b2f3a;

  --text: #eceef4;
  --text-soft: #a8acb8;
  --text-muted: #686d79;

  --purple: #9b5cff;
  --purple-2: #7b3ff2;
  --purple-soft: rgba(155, 92, 255, 0.12);

  --green: #39d98a;
  --red: #ff5c70;
  --yellow: #e7b84b;

  width: 100vw;
  height: 100vh;
  overflow: hidden;

  display: flex;
  flex-direction: column;

  background: var(--bg);
  color: var(--text);

  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  font-size: 13px;
}

/* =========================================================
   RESET
   ========================================================= */

.local-ai *,
.local-ai *::before,
.local-ai *::after {
  box-sizing: border-box;
}

.local-ai button,
.local-ai select,
.local-ai textarea {
  font: inherit;
}

.local-ai button {
  border: 0;
  outline: none;
  color: inherit;
  background: transparent;
  cursor: pointer;
}

.local-ai button:disabled {
  cursor: default;
  opacity: 0.45;
}

/* =========================================================
   TOP BAR
   ========================================================= */

.topbar {
  height: 52px;
  min-height: 52px;

  display: flex;
  align-items: center;

  padding: 0 15px;
  gap: 10px;

  border-bottom: 1px solid var(--border);
  background: #0b0c11;
}

.brand {
  width: 120px;

  display: flex;
  align-items: center;
  gap: 9px;

  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.brand-mark {
  width: 25px;
  height: 25px;

  display: grid;
  place-items: center;

  border-radius: 7px;

  color: white;
  background: linear-gradient(
    135deg,
    #b86cff,
    #7134e8
  );

  box-shadow:
    0 0 20px rgba(155, 92, 255, 0.25);
}

.project-select {
  height: 31px;

  display: flex;
  align-items: center;
  gap: 7px;

  max-width: 190px;

  padding: 0 10px;

  border: 1px solid var(--border);
  border-radius: 6px;

  background: var(--panel-2);
  color: var(--text-soft);

  font-size: 11px;
}

.project-select:hover {
  border-color: var(--border-light);
  color: var(--text);
}

.modes {
  height: 100%;

  display: flex;
  align-items: center;

  margin-left: 5px;
  gap: 2px;
}

.mode {
  height: 32px;

  padding: 0 12px;

  border-radius: 6px;

  color: var(--text-muted);
  font-size: 11px;
}

.mode:hover {
  color: var(--text);
  background: var(--panel-2);
}

.mode.active {
  color: #fff;
  background: var(--purple-soft);
}

.top-right {
  margin-left: auto;

  display: flex;
  align-items: center;
  gap: 6px;
}

.model {
  height: 31px;
  max-width: 210px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 6px;

  outline: none;

  background: var(--panel-2);
  color: var(--text-soft);

  font-size: 11px;
}

.model:focus {
  border-color: rgba(155, 92, 255, 0.55);
}

.top-icon,
.user-icon {
  width: 31px;
  height: 31px;

  display: grid;
  place-items: center;

  border-radius: 6px;

  color: var(--text-muted);
}

.top-icon:hover,
.user-icon:hover {
  background: var(--panel-2);
  color: var(--text);
}

.user-icon {
  color: white;
  background: #252834;
}

/* =========================================================
   WORKSPACE
   ========================================================= */

.workspace {
  min-height: 0;
  flex: 1;

  display: grid;

  grid-template-columns:
    215px
    minmax(0, 1fr)
    285px;

  overflow: hidden;
}

/* =========================================================
   LEFT SIDEBAR
   ========================================================= */

.left-sidebar {
  min-width: 0;

  display: flex;
  flex-direction: column;

  overflow-y: auto;

  border-right: 1px solid var(--border);
  background: #0c0e13;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.new-project {
  height: 35px;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  margin: 12px;

  border: 1px solid rgba(155, 92, 255, 0.4);
  border-radius: 7px;

  color: #dfd0ff;
  background: var(--purple-soft);

  font-size: 11px;
  font-weight: 600;

  transition: 0.15s ease;
}

.new-project:hover {
  border-color: rgba(155, 92, 255, 0.65);
  background: rgba(155, 92, 255, 0.19);
}

.sidebar-section {
  padding: 7px 10px 10px;
}

.section-title {
  margin-bottom: 7px;

  color: #686d79;

  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.sidebar-row {
  min-height: 29px;

  display: flex;
  align-items: center;
  gap: 8px;

  padding: 0 8px;

  border-radius: 6px;

  color: var(--text-soft);

  font-size: 11px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;

  transition:
    background 0.12s ease,
    color 0.12s ease;
}

.sidebar-row svg {
  flex-shrink: 0;
}

.sidebar-row:hover {
  background: var(--panel-2);
  color: var(--text);
}

.sidebar-row.selected {
  color: #eadfff;
  background: var(--purple-soft);
}

.sidebar-row.muted {
  margin-top: 2px;
  color: var(--text-muted);
}

.tools {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 3px;
}

.tool {
  height: 44px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 4px;

  border-radius: 6px;

  color: var(--text-muted);

  font-size: 8px;
}

.tool:hover {
  color: var(--text);
  background: var(--panel-2);
}

.system-status {
  margin-top: auto;

  padding: 12px;

  border-top: 1px solid var(--border);
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 4px 0;

  color: var(--text-muted);
  font-size: 10px;
}

.status-row strong {
  color: var(--text-soft);
  font-weight: 600;
}

/* =========================================================
   CENTER
   ========================================================= */

.center {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;

  background: #0a0c10;
}

/* =========================================================
   TASK HEADER
   ========================================================= */

.task-header {
  min-height: 68px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 0 20px;

  border-bottom: 1px solid var(--border);
  background: #0c0e13;
}

.task-title {
  display: flex;
  align-items: center;
  gap: 10px;
}

.task-title h1 {
  margin: 0;

  color: var(--text);

  font-size: 15px;
  font-weight: 650;
}

.progress {
  display: inline-flex;
  align-items: center;
  gap: 6px;

  color: var(--text-muted);

  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.progress i {
  width: 6px;
  height: 6px;

  display: block;

  border-radius: 50%;
  background: var(--green);

  box-shadow: 0 0 8px rgba(57, 217, 138, 0.6);
}

.task-subtitle {
  margin: 5px 0 0;

  color: var(--text-muted);

  font-size: 10px;
}

.task-buttons {
  display: flex;
  align-items: center;
  gap: 5px;
}

.task-buttons button {
  height: 29px;

  display: flex;
  align-items: center;
  gap: 6px;

  padding: 0 9px;

  border: 1px solid var(--border);
  border-radius: 6px;

  color: var(--text-muted);
  background: var(--panel);

  font-size: 10px;
}

.task-buttons button:hover:not(:disabled) {
  color: var(--text);
  border-color: var(--border-light);
}

.task-buttons .stop {
  color: #ff8794;
  border-color: rgba(255, 92, 112, 0.22);
  background: rgba(255, 92, 112, 0.06);
}

/* =========================================================
   CHAT
   ========================================================= */

.chat {
  min-height: 0;
  flex: 1;

  overflow-y: auto;

  padding: 24px 30px 20px;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.empty-chat {
  min-height: 100%;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  color: var(--text-muted);

  text-align: center;
}

.empty-chat svg {
  margin-bottom: 12px;

  color: var(--purple);

  opacity: 0.8;
}

.empty-chat h2 {
  margin: 0 0 6px;

  color: var(--text-soft);

  font-size: 18px;
  font-weight: 600;
}

.empty-chat p {
  margin: 0 0 8px;

  font-size: 12px;
}

.empty-chat small {
  max-width: 500px;

  color: #555b67;

  font-size: 10px;
  word-break: break-all;
}

.message {
  max-width: 900px;

  display: flex;
  gap: 11px;

  margin: 0 auto 22px;
}

.message-avatar {
  width: 28px;
  height: 28px;

  flex: 0 0 28px;

  display: grid;
  place-items: center;

  border: 1px solid var(--border);
  border-radius: 7px;

  color: var(--text-muted);
  background: var(--panel-2);
}

.message.ai .message-avatar {
  color: #d7c0ff;

  border-color: rgba(155, 92, 255, 0.25);
  background: rgba(155, 92, 255, 0.08);
}

.message.user .message-avatar {
  color: #c5cad4;
}

.message-body {
  min-width: 0;
  flex: 1;
}

.message-name {
  margin-bottom: 5px;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 700;
}

.message-body p {
  margin: 0;

  color: #c6cad3;

  font-size: 12px;
  line-height: 1.7;

  white-space: pre-wrap;
  overflow-wrap: anywhere;
}

.message.user .message-body p {
  color: #e0e3e9;
}

.thinking {
  color: var(--text-muted) !important;
  font-style: italic;
}

.ai-error {
  max-width: 900px;

  display: flex;
  gap: 8px;

  margin: 0 auto 18px;
  padding: 10px 12px;

  border: 1px solid rgba(255, 92, 112, 0.22);
  border-radius: 7px;

  color: #ff9aa5;
  background: rgba(255, 92, 112, 0.06);

  font-size: 11px;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer {
  min-height: 62px;

  display: flex;
  align-items: flex-end;
  gap: 7px;

  padding: 10px 18px 14px;

  border-top: 1px solid var(--border);
  background: #0c0e13;
}

.composer textarea {
  min-height: 39px;
  max-height: 150px;

  flex: 1;

  resize: none;

  padding: 11px 12px;

  border: 1px solid var(--border);
  border-radius: 7px;

  outline: none;

  color: var(--text);
  background: #101218;

  font-size: 12px;
  line-height: 1.45;

  scrollbar-width: thin;
}

.composer textarea::placeholder {
  color: #555b67;
}

.composer textarea:focus {
  border-color: rgba(155, 92, 255, 0.48);

  box-shadow:
    0 0 0 2px rgba(155, 92, 255, 0.06);
}

.composer > button {
  width: 39px;
  height: 39px;

  display: grid;
  place-items: center;

  flex: 0 0 39px;

  border: 1px solid var(--border);
  border-radius: 7px;

  color: var(--text-muted);
  background: var(--panel-2);
}

.composer > button:hover:not(:disabled) {
  color: var(--text);
  border-color: var(--border-light);
}

.composer > .send {
  color: white;
  border-color: rgba(155, 92, 255, 0.5);

  background: linear-gradient(
    135deg,
    #9b5cff,
    #7438df
  );

  box-shadow:
    0 0 15px rgba(155, 92, 255, 0.14);
}

/* =========================================================
   RIGHT SIDEBAR
   ========================================================= */

.right-sidebar {
  min-width: 0;
  min-height: 0;

  display: flex;
  flex-direction: column;

  overflow-y: auto;

  border-left: 1px solid var(--border);
  background: #0c0e13;

  scrollbar-width: thin;
  scrollbar-color: #292d37 transparent;
}

.right-tabs {
  height: 42px;
  min-height: 42px;

  display: flex;
  align-items: center;

  padding: 0 10px;

  gap: 4px;

  border-bottom: 1px solid var(--border);
}

.right-tabs button {
  height: 27px;

  padding: 0 8px;

  border-radius: 5px;

  color: var(--text-muted);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.05em;
}

.right-tabs button:hover {
  color: var(--text);
}

.right-tabs button.active {
  color: #ddd0ff;
  background: var(--purple-soft);
}

.file-tree {
  padding-bottom: 12px;

  border-bottom: 1px solid var(--border);
}

.path {
  min-height: 38px;

  display: flex;
  align-items: center;
  gap: 7px;

  padding: 0 12px;

  color: var(--text-muted);

  font-size: 10px;

  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.path svg {
  flex-shrink: 0;
  color: #9a9fac;
}

.tree-row {
  min-height: 25px;

  display: flex;
  align-items: center;
  gap: 5px;

  padding-right: 8px;

  color: #969ba7;

  font-size: 10px;

  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.tree-row:hover {
  color: var(--text);
  background: rgba(255, 255, 255, 0.025);
}

.tree-row svg {
  flex-shrink: 0;
}

.tree-row .folder {
  color: #c0a1ff;
}

.tree-indent {
  width: 11px;
  flex: 0 0 11px;
}

.info-card {
  padding: 14px 12px;

  border-bottom: 1px solid var(--border);
}

.info-row {
  min-height: 25px;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;

  color: var(--text-muted);

  font-size: 10px;
}

.info-row strong {
  max-width: 160px;

  color: var(--text-soft);

  font-size: 10px;
  font-weight: 500;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  padding: 14px 12px;
}

.timeline-row {
  min-height: 27px;

  display: grid;
  grid-template-columns: 32px 10px minmax(0, 1fr);
  align-items: center;
  gap: 5px;

  color: var(--text-muted);

  font-size: 9px;
}

.timeline-row strong {
  color: var(--purple);
  font-size: 7px;
}

.timeline-row p {
  margin: 0;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* =========================================================
   BOTTOM PANEL
   ========================================================= */

.bottom {
  height: 150px;
  min-height: 150px;

  border-top: 1px solid var(--border);

  background: #0b0d12;
}

.bottom-tabs {
  height: 36px;

  display: flex;
  align-items: center;

  padding: 0 14px;

  gap: 4px;

  border-bottom: 1px solid var(--border);
}

.bottom-tabs button {
  height: 28px;

  padding: 0 9px;

  border-radius: 5px;

  color: var(--text-muted);

  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.bottom-tabs button:hover {
  color: var(--text);
}

.bottom-tabs button.active {
  color: #d9c8ff;
  background: var(--purple-soft);
}

.bottom-content {
  height: calc(100% - 36px);

  display: grid;

  grid-template-columns:
    1fr
    1.4fr
    0.7fr
    1fr;

  gap: 20px;

  padding: 13px 18px;
}

.bottom-content > div {
  min-width: 0;
}

.bottom-content p {
  margin: 3px 0;

  color: var(--text-soft);

  font-size: 10px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bottom-content small {
  color: var(--text-muted);
  font-size: 9px;
}

.bottom-content code {
  color: #73e0a8;
  font-size: 10px;
}

.expected {
  padding-left: 16px;

  border-left: 1px solid var(--border);
}

/* =========================================================
   SCROLLBARS
   ========================================================= */

.local-ai ::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

.local-ai ::-webkit-scrollbar-track {
  background: transparent;
}

.local-ai ::-webkit-scrollbar-thumb {
  border-radius: 10px;
  background: #292d37;
}

.local-ai ::-webkit-scrollbar-thumb:hover {
  background: #363b48;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1050px) {
  .workspace {
    grid-template-columns:
      190px
      minmax(0, 1fr)
      245px;
  }

  .bottom-content {
    grid-template-columns:
      1fr
      1fr
      0.7fr;
  }

  .expected {
    display: none;
  }
}

@media (max-width: 820px) {
  .workspace {
    grid-template-columns:
      175px
      minmax(0, 1fr);
  }

  .right-sidebar {
    display: none;
  }

  .mode:nth-child(n + 3) {
    display: none;
  }
}

/* =========================================================
   LOCAL AI — STAGE 1 WORKSPACE UPGRADE
   UI ONLY — existing application logic untouched
   ========================================================= */

.local-ai {
  --bg: #07080d;
  --panel: #0b0d13;
  --panel-2: #10121a;
  --panel-3: #151822;

  --border: #1d202b;
  --border-light: #303443;

  --text: #f1f2f7;
  --text-soft: #b3b7c4;
  --text-muted: #6d7280;

  --purple: #9b5cff;
  --purple-2: #7437e8;
  --purple-soft: rgba(155, 92, 255, 0.11);

  --green: #39d98a;
  --red: #ff5c70;
  --yellow: #e7b84b;

  background:
    radial-gradient(
      circle at 50% -20%,
      rgba(112, 54, 220, 0.08),
      transparent 38%
    ),
    var(--bg);

  letter-spacing: -0.01em;
}

/* =========================================================
   HEADER
   ========================================================= */

.topbar {
  height: 56px;
  min-height: 56px;

  padding: 0 16px;

  background:
    linear-gradient(
      180deg,
      rgba(15, 17, 25, 0.98),
      rgba(9, 11, 16, 0.98)
    );

  border-bottom: 1px solid #20232e;

  box-shadow:
    0 1px 20px rgba(0, 0, 0, 0.22);
}

.brand {
  width: 145px;
  gap: 10px;
}

.brand-mark {
  width: 28px;
  height: 28px;

  border: 1px solid rgba(196, 157, 255, 0.28);
  border-radius: 8px;

  background:
    radial-gradient(
      circle at 30% 25%,
      #c895ff,
      #8a48ee 55%,
      #5e28c7
    );

  box-shadow:
    0 0 18px rgba(155, 92, 255, 0.22),
    inset 0 1px 0 rgba(255,255,255,0.15);
}

.brand strong {
  font-size: 12px;
  letter-spacing: 0.13em;
}

.brand::after {
  content: "AI WORKSPACE";

  position: absolute;

  margin-left: 137px;
  margin-top: 25px;

  color: #4f5461;

  font-size: 6px;
  font-weight: 700;
  letter-spacing: 0.12em;

  pointer-events: none;
}

.project-select {
  max-width: 210px;
  height: 32px;

  background: rgba(17, 19, 27, 0.9);

  border-color: #272b37;

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.015);
}

.project-select:hover {
  background: #151822;
  border-color: #383d4b;
}

.modes {
  margin-left: 8px;
}

.mode {
  position: relative;

  height: 34px;

  padding: 0 13px;

  color: #747987;

  font-size: 10px;
  font-weight: 650;
  letter-spacing: 0.02em;
}

.mode.active {
  color: #eee8ff;
  background: rgba(155, 92, 255, 0.10);
}

.mode.active::after {
  content: "";

  position: absolute;

  left: 12px;
  right: 12px;
  bottom: 0;

  height: 2px;

  border-radius: 2px;

  background: var(--purple);

  box-shadow:
    0 0 8px rgba(155, 92, 255, 0.55);
}

.model {
  height: 32px;

  background: #11131b;
  border-color: #282c38;

  color: #b9bdc8;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.model:hover {
  border-color: #393e4c;
}

.top-icon,
.user-icon {
  height: 32px;
  width: 32px;

  border: 1px solid transparent;
}

.top-icon:hover {
  border-color: #272b37;
}

.user-icon {
  border: 1px solid #353947;
}

/* =========================================================
   THREE COLUMN WORKSPACE
   ========================================================= */

.workspace {
  grid-template-columns:
    230px
    minmax(0, 1fr)
    300px;

  background: #080a0f;
}

/* =========================================================
   LEFT SIDEBAR
   ========================================================= */

.left-sidebar {
  background:
    linear-gradient(
      180deg,
      #0b0d13 0%,
      #090b10 100%
    );

  border-right-color: #20232d;
}

.new-project {
  height: 36px;

  margin: 13px 12px;

  border-color: rgba(155, 92, 255, 0.38);

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.15),
      rgba(116, 55, 232, 0.08)
    );

  box-shadow:
    0 4px 18px rgba(0, 0, 0, 0.12);
}

.new-project:hover {
  transform: translateY(-1px);

  border-color: rgba(155, 92, 255, 0.65);

  box-shadow:
    0 5px 22px rgba(96, 44, 190, 0.15);
}

.sidebar-section {
  padding: 8px 10px 11px;
}

.section-title {
  color: #5f6471;

  font-size: 8px;
  letter-spacing: 0.13em;
}

.sidebar-row {
  min-height: 30px;

  padding: 0 9px;

  border: 1px solid transparent;
  border-radius: 6px;

  color: #858a97;

  transition:
    background 0.12s ease,
    border-color 0.12s ease,
    color 0.12s ease;
}

.sidebar-row:hover {
  background: #11141c;
  border-color: #1e222c;
}

.sidebar-row.selected {
  color: #e5d8ff;

  border-color: rgba(155, 92, 255, 0.16);

  background:
    linear-gradient(
      90deg,
      rgba(155, 92, 255, 0.14),
      rgba(155, 92, 255, 0.04)
    );

  box-shadow:
    inset 2px 0 0 var(--purple);
}

.sidebar-row.muted {
  color: #5f6470;
}

.tools {
  gap: 4px;
}

.tool {
  height: 47px;

  border: 1px solid transparent;
  border-radius: 7px;

  color: #686e7b;

  transition:
    background 0.12s ease,
    border-color 0.12s ease;
}

.tool:hover {
  background: #11141c;
  border-color: #20242f;
}

.system-status {
  padding: 13px;

  background:
    linear-gradient(
      180deg,
      transparent,
      rgba(255,255,255,0.008)
    );
}

.status-row {
  min-height: 24px;
}

.status-row strong {
  color: #8d93a0;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

/* =========================================================
   CENTER WORKSPACE
   ========================================================= */

.center {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(155, 92, 255, 0.025),
      transparent 35%
    ),
    #090b10;
}

.task-header {
  min-height: 72px;

  padding: 0 22px;

  background:
    linear-gradient(
      180deg,
      #0d0f15,
      #0b0d12
    );

  border-bottom-color: #20232d;
}

.task-title h1 {
  font-size: 15px;
  letter-spacing: -0.015em;
}

.task-subtitle {
  color: #646a77;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.progress {
  padding: 3px 7px;

  border: 1px solid rgba(57, 217, 138, 0.12);
  border-radius: 10px;

  background: rgba(57, 217, 138, 0.035);

  font-size: 8px;
}

.chat {
  padding:
    28px
    clamp(24px, 5vw, 70px)
    22px;

  background:
    radial-gradient(
      ellipse at 50% 15%,
      rgba(92, 51, 164, 0.035),
      transparent 45%
    );
}

.empty-chat svg {
  width: 38px;
  height: 38px;

  padding: 8px;

  border: 1px solid rgba(155, 92, 255, 0.22);
  border-radius: 10px;

  background: rgba(155, 92, 255, 0.07);

  filter:
    drop-shadow(
      0 0 14px rgba(155, 92, 255, 0.22)
    );
}

.empty-chat h2 {
  margin-top: 2px;

  font-size: 19px;
  letter-spacing: -0.02em;
}

.empty-chat p {
  color: #777c89;
}

.message {
  max-width: 980px;

  margin-bottom: 25px;
}

.message-avatar {
  width: 30px;
  height: 30px;

  flex-basis: 30px;

  border-radius: 8px;

  background: #10131a;
}

.message.ai .message-avatar {
  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.15),
      rgba(116, 55, 232, 0.05)
    );

  border-color: rgba(155, 92, 255, 0.25);
}

.message-name {
  color: #8d92a0;

  font-size: 9px;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.message.ai .message-name {
  color: #b99bff;
}

.message-body p {
  color: #c7cbd4;

  font-size: 12px;
  line-height: 1.75;
}

.ai-error {
  border-radius: 8px;

  background:
    linear-gradient(
      90deg,
      rgba(255, 92, 112, 0.08),
      rgba(255, 92, 112, 0.035)
    );

  box-shadow:
    0 4px 20px rgba(0,0,0,0.12);
}

/* =========================================================
   EDIT PROPOSAL
   ========================================================= */

.edit-proposal {
  margin:
    0
    clamp(18px, 5vw, 70px)
    12px;

  overflow: hidden;

  border: 1px solid rgba(155, 92, 255, 0.22);
  border-radius: 9px;

  background: #0c0f15;

  box-shadow:
    0 8px 30px rgba(0, 0, 0, 0.2),
    0 0 20px rgba(155, 92, 255, 0.035);
}

.edit-proposal-header {
  min-height: 49px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 8px 11px;

  border-bottom: 1px solid #20232d;

  background:
    linear-gradient(
      90deg,
      rgba(155, 92, 255, 0.08),
      transparent
    );
}

.edit-proposal-header > div:first-child {
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 3px;
}

.edit-proposal-header strong {
  color: #ddd2f4;

  font-size: 10px;
}

.edit-proposal-header span {
  color: #777d8b;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;

  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-proposal-actions {
  display: flex;
  gap: 5px;
}

.edit-proposal-actions button {
  height: 27px;

  padding: 0 9px;

  border: 1px solid #2a2e39;
  border-radius: 5px;

  color: #8b909c;

  background: #11141b;

  font-size: 9px;
  font-weight: 650;
}

.edit-proposal-actions button:hover {
  color: #e5e7ed;
  border-color: #3b4050;
}

.edit-proposal-actions .apply-edit {
  color: #eadfff;

  border-color: rgba(155, 92, 255, 0.38);

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.18),
      rgba(116, 55, 232, 0.10)
    );
}

.edit-proposal pre {
  max-height: 220px;

  margin: 0;

  padding: 13px;

  overflow: auto;

  color: #abb0bc;

  background: #090b10;

  font-family:
    "JetBrains Mono",
    "Fira Code",
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 10px;
  line-height: 1.65;

  white-space: pre-wrap;
}

/* =========================================================
   COMPOSER
   ========================================================= */

.composer {
  min-height: 70px;

  padding:
    10px
    clamp(18px, 4vw, 58px)
    15px;

  background:
    linear-gradient(
      180deg,
      #0b0d12,
      #0d0f15
    );

  border-top-color: #20232d;
}

.composer textarea {
  min-height: 42px;

  background: #10131a;

  border-color: #272b36;

  box-shadow:
    inset 0 1px 3px rgba(0,0,0,0.18);
}

.composer textarea:focus {
  border-color: rgba(155, 92, 255, 0.55);

  box-shadow:
    0 0 0 2px rgba(155, 92, 255, 0.055),
    0 0 18px rgba(155, 92, 255, 0.035);
}

.composer > button {
  width: 42px;
  height: 42px;

  flex-basis: 42px;

  border-radius: 8px;
}

.composer > .send {
  border-color: rgba(155, 92, 255, 0.55);

  background:
    linear-gradient(
      135deg,
      #a361ff,
      #7437e8
    );

  box-shadow:
    0 0 18px rgba(155, 92, 255, 0.17);
}

/* =========================================================
   RIGHT SIDEBAR
   ========================================================= */

.right-sidebar {
  background:
    linear-gradient(
      180deg,
      #0b0d13,
      #090b10
    );

  border-left-color: #20232d;
}

.right-tabs {
  height: 44px;
  min-height: 44px;

  padding: 0 11px;
}

.right-tabs button {
  font-size: 8px;
  letter-spacing: 0.08em;
}

.right-tabs button.active {
  color: #ded1fa;

  background:
    linear-gradient(
      135deg,
      rgba(155, 92, 255, 0.13),
      rgba(155, 92, 255, 0.05)
    );
}

.file-tree {
  background: rgba(255,255,255,0.003);
}

.path {
  min-height: 40px;

  padding: 0 13px;

  border-bottom: 1px solid rgba(255,255,255,0.015);

  color: #727784;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.path svg {
  color: #a078ed;
}

.tree-row {
  min-height: 27px;

  padding-right: 10px;

  color: #888e9b;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.tree-row:hover {
  background: rgba(155, 92, 255, 0.045);
}

.tree-row .folder {
  color: #a77cff;
}

.info-card {
  padding: 13px;

  background:
    linear-gradient(
      180deg,
      rgba(255,255,255,0.008),
      transparent
    );
}

.info-row {
  min-height: 27px;
}

.info-row strong {
  color: #a8adb9;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.timeline {
  padding: 14px 13px;
}

.timeline-row {
  min-height: 29px;

  grid-template-columns: 30px 10px minmax(0,1fr);

  font-size: 8px;
}

.timeline-row strong {
  color: #9b5cff;

  text-shadow:
    0 0 8px rgba(155, 92, 255, 0.6);
}

/* =========================================================
   BOTTOM WORKSPACE
   ========================================================= */

.bottom {
  height: 158px;
  min-height: 158px;

  background:
    linear-gradient(
      180deg,
      #0b0d12,
      #090b10
    );

  box-shadow:
    0 -8px 25px rgba(0,0,0,0.08);
}

.bottom-tabs {
  height: 38px;

  padding: 0 15px;
}

.bottom-tabs button {
  position: relative;

  font-size: 8px;
  letter-spacing: 0.08em;
}

.bottom-tabs button.active {
  color: #ded1fa;

  background: rgba(155, 92, 255, 0.10);
}

.bottom-tabs button.active::after {
  content: "";

  position: absolute;

  left: 8px;
  right: 8px;
  bottom: 0;

  height: 1px;

  background: var(--purple);
}

.bottom-content {
  height: calc(100% - 38px);

  grid-template-columns:
    0.9fr
    1.7fr
    0.8fr
    1.1fr;

  gap: 24px;

  padding: 14px 19px;
}

.bottom-content p {
  color: #b0b4bf;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.bottom-content small {
  color: #626875;

  font-size: 8px;
}

.bottom-content code {
  color: #61dca1;

  font-family:
    ui-monospace,
    SFMono-Regular,
    Menlo,
    Monaco,
    Consolas,
    monospace;

  font-size: 9px;
}

.expected {
  border-left-color: #222631;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  .workspace {
    grid-template-columns:
      210px
      minmax(0, 1fr)
      260px;
  }

  .brand {
    width: 125px;
  }

  .brand::after {
    display: none;
  }

  .project-select {
    max-width: 160px;
  }

  .mode {
    padding: 0 9px;
  }
}

@media (max-width: 950px) {
  .workspace {
    grid-template-columns:
      190px
      minmax(0, 1fr)
      235px;
  }

  .bottom-content {
    grid-template-columns:
      1fr
      1fr
      0.7fr;
  }

  .expected {
    display: none;
  }
}

@media (max-width: 780px) {
  .workspace {
    grid-template-columns:
      175px
      minmax(0, 1fr);
  }

  .right-sidebar {
    display: none;
  }

  .mode:nth-child(n + 3) {
    display: none;
  }
}
