+}
+
+.file-tree {
+  padding: 10px 9px 13px;
+
+  border-bottom: 1px solid var(--border);
+}
+
+.path {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+
+  margin-bottom: 7px;
+
+  color: #aeb2bc;
+
+  font-size: 10px;
+}
+
+.tree {
+  color: #9196a2;
+}
+
+.tree-row {
+  min-height: 23px;
+
+  display: flex;
