+                                                                                               
+                                                                                               
+                                                                                               
+  margin: 12px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid rgba(155, 92, 255, 0.45);                                                  
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 6px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #d9c5ff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--purple-soft);                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 12px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.new-project:hover {                                                                           
+                                                                                               
+  background: rgba(155, 92, 255, 0.2);                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-section {                                                                             
+                                                                                               
+  padding: 7px 10px 9px;                                                                       
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.section-title {                                                                               
+                                                                                               
+  margin-bottom: 7px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #686e7b;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+  font-weight: 800;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  letter-spacing: 0.09em;                                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-row {                                                                                 
+                                                                                               
+  min-height: 28px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 8px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 8px;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-soft);                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 5px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 11px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  white-space: nowrap;                                                                         
+                                                                                               
+  overflow: hidden;                                                                            
+                                                                                               
+  text-overflow: ellipsis;                                                                     
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-row svg {                                                                             
+                                                                                               
+  flex-shrink: 0;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-row:hover {                                                                           
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+  color: var(--text);                                                                          
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-row.selected {                                                                        
+                                                                                               
+  color: #e9ddff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--purple-soft);                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.sidebar-row.muted {                                                                           
+                                                                                               
+  margin-top: 2px;                                                                             
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tools {                                                                                       
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  grid-template-columns: repeat(4, 1fr);                                                       
+                                                                                               
+  gap: 3px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tool {                                                                                        
+                                                                                               
+  height: 42px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  flex-direction: column;                                                                      
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: center;                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  gap: 4px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 5px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 8px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tool:hover {                                                                                  
+                                                                                               
+  color: var(--text);                                                                          
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.system-status {                                                                               
+                                                                                               
+  margin-top: auto;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 12px;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  border-top: 1px solid var(--border);                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.status {                                                                                      
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 4px 0;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.status span {                                                                                 
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 6px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.status i {                                                                                    
+                                                                                               
+  width: 5px;                                                                                  
+                                                                                               
+  height: 5px;                                                                                 
+                                                                                               
+                                                                                               
+                                                                                               
+  display: inline-block;                                                                       
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 50%;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--green);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  box-shadow: 0 0 7px var(--green);                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.status strong {                                                                               
+                                                                                               
+  color: var(--text-soft);                                                                     
+                                                                                               
+  font-weight: 500;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   CENTER                                                                                      
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.center {                                                                                      
+                                                                                               
+  min-width: 0;                                                                                
+                                                                                               
+  min-height: 0;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  flex-direction: column;                                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  overflow: hidden;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0b0d12;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   TASK HEADER                                                                                 
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.task-header {                                                                                 
+                                                                                               
+  min-height: 68px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 10px 17px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #101218;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-title {                                                                                  
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 9px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-title h1 {                                                                               
+                                                                                               
+  margin: 0;                                                                                   
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #f1f2f5;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 14px;                                                                             
+                                                                                               
+  font-weight: 650;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.progress {                                                                                    
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 3px 7px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid rgba(155, 92, 255, 0.25);                                                  
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 999px;                                                                        
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #c8aaff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--purple-soft);                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.progress i {                                                                                  
+                                                                                               
+  width: 5px;                                                                                  
+                                                                                               
+  height: 5px;                                                                                 
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 50%;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--purple);                                                                   
+                                                                                               
+                                                                                               
+                                                                                               
+  box-shadow: 0 0 8px var(--purple);                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-subtitle {                                                                               
+                                                                                               
+  margin: 4px 0 0;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-buttons {                                                                                
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-buttons button {                                                                         
+                                                                                               
+  height: 27px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 8px;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid var(--border);                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 5px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-buttons .stop {                                                                          
+                                                                                               
+  color: #ff8490;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.task-buttons button:hover {                                                                   
+                                                                                               
+  background: var(--panel-3);                                                                  
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   CHAT                                                                                        
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.chat {                                                                                        
+                                                                                               
+  min-height: 0;                                                                               
+                                                                                               
+  flex: 1;                                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  overflow-y: auto;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 16px 19px 12px;                                                                     
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.message {                                                                                     
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  gap: 10px;                                                                                   
+                                                                                               
+                                                                                               
+                                                                                               
+  max-width: 850px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  margin-bottom: 24px;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.message-avatar {                                                                              
+                                                                                               
+  width: 25px;                                                                                 
+                                                                                               
+  height: 25px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  flex-shrink: 0;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  place-items: center;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 6px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #aaa;                                                                                 
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #1a1d26;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.message.user .message-avatar {                                                                
+                                                                                               
+  color: #d4baff;                                                                              
+                                                                                               
+  background: var(--purple-soft);                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.message-name {                                                                                
+                                                                                               
+  margin-bottom: 8px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--purple);                                                                        
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 13px;                                                                             
+                                                                                               
+  font-weight: 700;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.message p {                                                                                   
+                                                                                               
+  margin: 0;                                                                                   
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #c8cbd3;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 15px;                                                                             
+                                                                                               
+  line-height: 1.6;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   AGENT ACTIVITY                                                                              
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.agent-activity {                                                                              
+                                                                                               
+  max-width: 620px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  margin: 6px 0 17px 35px;                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid var(--border);                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 7px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  overflow: hidden;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0e1016;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.activity-header {                                                                             
+                                                                                               
+  height: 32px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 10px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-soft);                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.activity-header span {                                                                        
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 6px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.activity-header strong {                                                                      
+                                                                                               
+  color: var(--green);                                                                         
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.agent-step {                                                                                  
+                                                                                               
+  min-height: 27px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 8px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 10px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid rgba(37, 40, 52, 0.5);                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #9ca1ad;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 13px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.agent-step:last-child {                                                                       
+                                                                                               
+  border-bottom: 0;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.agent-step .check {                                                                           
+                                                                                               
+  width: 15px;                                                                                 
+                                                                                               
+  height: 15px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  place-items: center;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 50%;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--green);                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--green-soft);                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.agent-step small {                                                                            
+                                                                                               
+  margin-left: auto;                                                                           
+                                                                                               
+  color: var(--green);                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   PROPOSED CHANGES                                                                            
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.proposed {                                                                                    
+                                                                                               
+  max-width: 620px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  margin: 5px 0 17px 35px;                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid var(--border);                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 7px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #101219;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.proposed-header {                                                                             
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 9px 11px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.proposed-header > div {                                                                       
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 8px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.proposed-header strong {                                                                      
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.proposed-header span {                                                                        
+                                                                                               
+  padding: 2px 5px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #1a1d25;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 4px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 8px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.show-diff {                                                                                   
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 4px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #bfa0ff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.changed-files {                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  gap: 8px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 9px 11px;                                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.changed-files span {                                                                          
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 5px 7px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid var(--border);                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 5px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #aeb2bd;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0d0f14;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   CENTER LOWER / DIFF                                                                         
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.center-lower {                                                                                
+                                                                                               
+  flex-shrink: 0;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  border-top: 1px solid var(--border);                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0d0f14;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-header {                                                                                 
+                                                                                               
+  height: 31px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 10px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #9ca1ad;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-header div {                                                                             
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  gap: 2px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-header button {                                                                          
+                                                                                               
+  padding: 3px 7px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 3px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 8px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-header button:hover {                                                                    
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff {                                                                                        
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  grid-template-columns: 1fr 1fr;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  min-height: 108px;                                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-old,                                                                                     
+                                                                                               
+.diff-new {                                                                                    
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  flex-direction: column;                                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 6px 10px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  font-family: "JetBrains Mono", "Fira Code", monospace;                                       
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+  line-height: 1.65;                                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-old {                                                                                    
+                                                                                               
+  border-right: 1px solid var(--border);                                                       
+                                                                                               
+  background: rgba(255, 93, 108, 0.035);                                                       
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-new {                                                                                    
+                                                                                               
+  background: rgba(53, 208, 127, 0.035);                                                       
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-title {                                                                                  
+                                                                                               
+  margin-bottom: 3px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-family: Inter, sans-serif;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 8px;                                                                              
+                                                                                               
+  font-weight: 800;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-title.red {                                                                              
+                                                                                               
+  color: var(--red);                                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-title.green {                                                                            
+                                                                                               
+  color: var(--green);                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-old code {                                                                               
+                                                                                               
+  color: #d18a92;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-new code {                                                                               
+                                                                                               
+  color: #86cfa7;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-actions {                                                                                
+                                                                                               
+  position: absolute;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  margin-top: -35px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  right: 280px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.diff-actions button {                                                                         
+                                                                                               
+  height: 25px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 9px;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 5px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.reject {                                                                                      
+                                                                                               
+  color: #ff8792;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  border: 1px solid rgba(255, 93, 108, 0.2);                                                   
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--red-soft);                                                                 
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.apply {                                                                                       
+                                                                                               
+  color: white;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  background: linear-gradient(                                                                 
+                                                                                               
+    135deg,                                                                                    
+                                                                                               
+    #9b5cff,                                                                                   
+                                                                                               
+    #7436db                                                                                    
+                                                                                               
+  );                                                                                           
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   TERMINAL                                                                                    
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.terminal {                                                                                    
+                                                                                               
+  border-top: 1px solid var(--border);                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.terminal-title {                                                                              
+                                                                                               
+  height: 27px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 0 10px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0a0c10;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.terminal-title span {                                                                         
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.terminal-output {                                                                             
+                                                                                               
+  min-height: 38px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  flex-direction: column;                                                                      
+                                                                                               
+  gap: 4px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 7px 11px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #8d939f;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #080a0d;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  font-family: "JetBrains Mono", "Fira Code", monospace;                                       
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.terminal-error {                                                                              
+                                                                                               
+  color: #ef707c;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   COMPOSER                                                                                    
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.composer {                                                                                    
+                                                                                               
+  height: 68px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 14px 16px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  border-top: 1px solid var(--border);                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0f1117;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.composer > span {                                                                             
+                                                                                               
+  flex: 1;                                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #606571;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding-left: 7px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 15px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.composer button {                                                                             
+                                                                                               
+  width: 40px;                                                                                 
+                                                                                               
+  height: 40px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  place-items: center;                                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 8px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.composer .send {                                                                              
+                                                                                               
+  color: white;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  background: var(--purple);                                                                   
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   RIGHT SIDEBAR                                                                               
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.right-sidebar {                                                                               
+                                                                                               
+  min-width: 0;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  overflow-y: auto;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  border-left: 1px solid var(--border);                                                        
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0e1015;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.right-tabs {                                                                                  
+                                                                                               
+  height: 37px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.right-tabs button {                                                                           
+                                                                                               
+  flex: 1;                                                                                     
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+  font-weight: 700;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.right-tabs button.active {                                                                    
+                                                                                               
+  color: #d9c4ff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  box-shadow:                                                                                  
+                                                                                               
+    inset 0 -2px 0 var(--purple);                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.file-tree {                                                                                   
+                                                                                               
+  padding: 10px 9px 13px;                                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.path {                                                                                        
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 6px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  margin-bottom: 7px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  color: #aeb2bc;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 10px;                                                                             
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree {                                                                                        
+                                                                                               
+  color: #9196a2;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree-row {                                                                                    
+                                                                                               
+  min-height: 23px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  padding-left: 2px;                                                                           
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 3px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree-row:hover {                                                                              
+                                                                                               
+  color: var(--text);                                                                          
+                                                                                               
+  background: var(--panel-2);                                                                  
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree-space {                                                                                  
+                                                                                               
+  width: 12px;                                                                                 
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree .folder {                                                                                
+                                                                                               
+  color: #a978ff;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.tree-children {                                                                               
+                                                                                               
+  padding-left: 12px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  border-left: 1px solid #22252e;                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.info {                                                                                        
+                                                                                               
+  padding: 12px;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.info-row {                                                                                    
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  justify-content: space-between;                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  padding: 3px 0;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.info-row strong {                                                                             
+                                                                                               
+  color: #aeb2bc;                                                                              
+                                                                                               
+  font-weight: 500;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.timeline {                                                                                    
+                                                                                               
+  padding: 12px;                                                                               
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.timeline-row {                                                                                
+                                                                                               
+  min-height: 25px;                                                                            
+                                                                                               
+                                                                                               
+                                                                                               
+  display: grid;                                                                               
+                                                                                               
+  grid-template-columns: 35px 8px 1fr;                                                         
+                                                                                               
+  align-items: center;                                                                         
+                                                                                               
+  gap: 5px;                                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 8px;                                                                              
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.timeline-row i {                                                                              
+                                                                                               
+  width: 5px;                                                                                  
+                                                                                               
+  height: 5px;                                                                                 
+                                                                                               
+                                                                                               
+                                                                                               
+  border-radius: 50%;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #7552a8;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+/* =========================================================                                   
+                                                                                               
+   BOTTOM PANEL                                                                                
+                                                                                               
+   ========================================================= */                                
+                                                                                               
+                                                                                               
+                                                                                               
+.bottom {                                                                                      
+                                                                                               
+  flex-shrink: 0;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  height: 148px;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+  flex-direction: column;                                                                      
+                                                                                               
+                                                                                               
+                                                                                               
+  border-top: 1px solid var(--border);                                                         
+                                                                                               
+                                                                                               
+                                                                                               
+  background: #0f1117;                                                                         
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.bottom-tabs {                                                                                 
+                                                                                               
+  height: 32px;                                                                                
+                                                                                               
+                                                                                               
+                                                                                               
+  display: flex;                                                                               
+                                                                                               
+                                                                                               
+                                                                                               
+  padding-left: 10px;                                                                          
+                                                                                               
+                                                                                               
+                                                                                               
+  border-bottom: 1px solid var(--border);                                                      
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.bottom-tabs button {                                                                          
+                                                                                               
+  padding: 0 12px;                                                                             
+                                                                                               
+                                                                                               
+                                                                                               
+  color: var(--text-muted);                                                                    
+                                                                                               
+                                                                                               
+                                                                                               
+  font-size: 9px;                                                                              
+                                                                                               
+  font-weight: 700;                                                                            
+                                                                                               
+}                                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+.bottom-tabs button.active {                                                                   
+                                                                                               
+  color: #d9c4ff;                                                                              
+                                                                                               
+                                                                                               
+                                                                                               
+  box-shadow:                                                                                  
+                                                                                               
+    inset 0 -2px 0 var(--purple);                                                              
+                                                                                               
+}                                                                                              
